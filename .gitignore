Drivers

# Root Makefile only (already tracked; this is defensive against local
# regeneration) — NOT anchored bare "Makefile" would also swallow the
# per-core build files under cores/<name>/Makefile (see cores/_template/).
/Makefile
Core/Inc/rom_info.h
Core/Inc/gittag.h
roms
gwemusd
sd_content

release

.mxproject

saveflash.ld

rom_hashes.txt

linux/loaded_gb_rom.c
