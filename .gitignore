linux/loaded_o2em_rom.c
linux/loaded_a2600_rom.c
linux/loaded_pkmini_rom.c
linux/loaded_gwenesis_rom.c
linux/loaded_lynx_rom.c

save_states

# cores/<name>/ mixes tracked source (Makefile, linker script) with build
# output — the generated package (cores/<name>.bin) and build dir are
# already caught by the generic *.bin / build rules below, spelled out
# here so it's obvious at a glance nothing under cores/ needs manual
# cleanup before a commit.
cores/*.bin
cores/*/build
cores/nes_fceumm_mappers/

venv

**/.DS_Store

**/*.pyc

.vs/*
.vscode/*
*.bin
.gdbinit
screenshot.png
/backup
.clang-format
.idea/
cmake-build-debug
.gitignore.local
choices.yaml
build-error.log
.bash_history
*.sfc

# gwemu emulator binary (downloaded, lives at repo root so make clean does not wipe it)
gwemu_bin
gwemu_bin.version
.gwemu_tmp/
# On macOS gwemu ships as an .app bundle whose executable loads its dylibs from
# a sibling Frameworks/ dir, so the bundle is kept and gwemu_bin symlinks into it.
gwemu.app/

# Session logs from scripts/run_gwemu.sh. The default (build/gwemu.log) is already
# covered by build/, but --log-file can point anywhere. No .log files are tracked.
*.log
.gwemu_release_cache
