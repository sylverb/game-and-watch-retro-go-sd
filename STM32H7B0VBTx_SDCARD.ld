    . = ALIGN(4);
    _OVERLAY_NES_FCEU_BSS_END = .;
    __ram_emu_nes_fceu_end__ = .;
    ASSERT(ABSOLUTE(_OVERLAY_NES_FCEU_BSS_END) < __RAM_EMU_END__, "Error: NES_FCEU BSS overflow");
  }
  _OVERLAY_NES_FCEU_BSS_SIZE = SIZEOF(.overlay_nes_fceu_bss);

