/* Entry Point */
ENTRY(Reset_Handler)

/* Highest address of the user mode stack */
_estack = _stack_top;    /* end of RAM */

/* Stack is fixed at the top of DTCM (fast). Firmware .persistent, .data,
 * .bss and the stdlib heap live in AHB SRAM below the .audio DMA reserve
 * (AHB SRAM clock enabled via DATA_IN_D2_SRAM in SystemInit). dtcm_malloc
 * bumps the free space between DTCM ORIGIN and the stack. */
/* Stack + redzone occupy exactly 24 KiB at the top of DTCM. Redzone is the
 * low 32 bytes of that window (overflow edge; stack grows downward). */
_Stack_Redzone_Size = 32;
_Min_Stack_Size = 24 * 1024 - _Stack_Redzone_Size;


/* Useful for scripts */
//__NULLPTR_LENGTH__  = 0x100;
__NULLPTR_LENGTH__  = 0x0;
__ITCMRAM_LENGTH__  = 64K;
__DTCMRAM_LENGTH__  = 128K;
/* __RAM_UC_LENGTH__ / __RAM_EMU_LENGTH__ / __RAM_START__ / __RAM_EMU_START__ /
 * __RAM_EMU_END__ come from ld/gnw_ram_emu.ld, shared with every standalone
 * core's linker script so the VMA a core is built for can never drift from
 * where the firmware actually loads it (see run_dynamic_core()). */
INCLUDE ld/gnw_ram_emu.ld
/* __ITCM_CORE_START__/__ITCM_CORE_LENGTH__ come from ld/gnw_itcm_core.ld
 * (shared with cores that place hot code in ITCM). __AHB_CORE_* from
 * ld/gnw_ahb_core.ld is legacy (AHB is heap-only now) and only used by the
 * ASSERTs below against this firmware's AHBRAM layout. */
INCLUDE ld/gnw_itcm_core.ld
INCLUDE ld/gnw_ahb_core.ld
__AHBRAM_LENGTH__   = 128K;
__AHBRAM_PERSISTENT_RESERVE__ = 8K; /* MPU non-cacheable: boot_magic/logbuf + remote-input */
__AHBRAM_REMOTE_INPUT_RESERVE__ = 12; /* last bytes of persistent pad; scripts/remote_input.py */
__AHBRAM_AUDIO_RESERVE__ = 8K; /* MPU non-cacheable slot for .audio DMA buffer at end of AHB SRAM */
__FLASH_LENGTH__    = 256K; /* Bank 1 */
__FLASH2_LENGTH__   = 256K; /* Bank 2 */
__RAM_FCEUMM_MAPPER_LENGTH__ = 48K; /* Current FCEUMM mapper code */

/* Usefull only for round robin flash allocator */
__EXTFLASH_OFFSET__ = DEFINED(__EXTFLASH_OFFSET__) ? __EXTFLASH_OFFSET__ : 0;  /* bytes reserved at the bottom by the chainloader */
__EXTFLASH_BASE__ = 0x90000000;  /* Beginning of addressable extflash addresses */
__EXTFLASH_START__ = __EXTFLASH_BASE__ + __EXTFLASH_OFFSET__;  /* Beginning of where we're going to store emulator and rom data (respect the reserved offset, matching STM32H7B0VBTx_FLASH.ld) */

__RAM_UC_START__    = __RAM_START__;

__RAM_FCEUMM_START__   = __RAM_START__ + __RAM_UC_LENGTH__ + __RAM_FCEUMM_MAPPER_LENGTH__;

__RAM_END__         = __RAM_START__ + 1024K;

__INTFLASH__ = DEFINED(__INTFLASH__) ? __INTFLASH__ : 0x08000000;

/* Specify the memory areas */
MEMORY
{
  /* RAM */
  NULLPTR  (xrw) : ORIGIN = 0x00000000, LENGTH =   __NULLPTR_LENGTH__
  ITCMRAM  (xrw) : ORIGIN = 0x00000000 + __NULLPTR_LENGTH__, LENGTH = __ITCMRAM_LENGTH__ - __NULLPTR_LENGTH__
  DTCMRAM  (xrw) : ORIGIN = 0x20000000, LENGTH =  __DTCMRAM_LENGTH__
  RAM_UC   (xrw) : ORIGIN = __RAM_UC_START__, LENGTH = __RAM_UC_LENGTH__
  RAM_EMU  (xrw) : ORIGIN = __RAM_EMU_START__, LENGTH = __RAM_EMU_LENGTH__
  RAM_FCEUMM  (xrw) : ORIGIN = __RAM_FCEUMM_START__, LENGTH = __RAM_EMU_LENGTH__ - __RAM_FCEUMM_MAPPER_LENGTH__
  AHBRAM   (xrw) : ORIGIN = 0x30000000, LENGTH =  __AHBRAM_LENGTH__

  /* FLASH */
  FLASH    (xr ) : ORIGIN = __INTFLASH__,        LENGTH =  __FLASH_LENGTH__

  /* CORES */
  CORES    (x)   : ORIGIN = 0x0,                 LENGTH = 0xFFFFFFFF

  /* RODATA */
  RODATA   (x)   : ORIGIN = 0xCAFE0000,   LENGTH = 0xFFFFFFFF

  /* PICO-8 code (sentinel address, patched to QSPI XIP at runtime) */
  PICO8_CODE (x) : ORIGIN = 0xBEEF0000,   LENGTH = 512K

  /* GBA: gpSP's scanline renderer plus the 16 KB BIOS image. Same sentinel trick
   * as PICO8_CODE — see .xip_gba below. */
  GBA_CODE   (x) : ORIGIN = 0xDEC00000,   LENGTH = 512K

  /* External flash (QSPI XIP) — for ITCM hot code LMA */
  EXTFLASH   (xr) : ORIGIN = __EXTFLASH_START__, LENGTH = 32M
}


/* Define output sections */
SECTIONS
{
  ._itcram :
  {
    __itcram_start__ = .;
  } > ITCMRAM

  /* ITCM hot code section — empty in GPL stub build.
     The separately-distributed engine binary loads its own ITCM code
     from /cores/pico8_itcm.bin at runtime. */
  ._itcram_hot :
  {
    __itcram_hot_start__ = .;
    __itcram_hot_end__ = .;
    __itcram_end__ = .;
  } > ITCMRAM

  ASSERT(__ITCM_CORE_START__ == __itcram_hot_start__,
         "Error: ld/gnw_itcm_core.ld's __ITCM_CORE_START__ no longer matches __itcram_hot_start__ — a core's fixed ITCM segment would overlap firmware-resident ITCM data")

  /* Uncached and unbuffered LCD framebuffer pool. Sized for the largest
   * supported mode (2x RGB565 framebuffers = 300K). lcd_setup_framebuffers()
   * carves it up at boot via __lcd_pool_start__; in LUT8 mode the upper
   * ~154K is freed as a "bonus pool" (lcd_get_bonus_pool()) that PICO-8
   * folds into its TLSF allocator via g_platform.scratch_base/size. */
  ._ram_uc (NOLOAD) :
  {
    __ram_uc_start__ = .;
    . = ALIGN(16);
    __lcd_pool_start__ = .;
    . = . + __RAM_UC_LENGTH__;
    __lcd_pool_end__ = .;
    __ram_uc_end__ = .;
  } > RAM_UC

  .sd_fonts_cp1251_greybeard : {
    . = ALIGN(4);
    KEEP(*(.sd_fonts_cp1251_greybeard))
  } > CORES

  .sd_fonts_cp1251_sans_serif_bold : {
    . = ALIGN(4);
    KEEP(*(.sd_fonts_cp1251_sans_serif_bold))
  } > CORES

  .sd_fonts_cp1251_sans_serif : {
    . = ALIGN(4);
    KEEP(*(.sd_fonts_cp1251_sans_serif))
  } > CORES

  .sd_fonts_cp1251_serif_bold : {
    . = ALIGN(4);
    KEEP(*(.sd_fonts_cp1251_serif_bold))
  } > CORES

  .sd_fonts_cp1251_serif : {
    . = ALIGN(4);
    KEEP(*(.sd_fonts_cp1251_serif))
  } > CORES

  .sd_fonts_cp1252_greybeard : {
    . = ALIGN(4);
    KEEP(*(.sd_fonts_cp1252_greybeard))
  } > CORES

  .sd_fonts_cp1252_haeberli12 : {
    . = ALIGN(4);
    KEEP(*(.sd_fonts_cp1252_haeberli12))
  } > CORES

  .sd_fonts_cp1252_rock12 : {
    . = ALIGN(4);
    KEEP(*(.sd_fonts_cp1252_rock12))
  } > CORES

  .sd_fonts_cp1252_sans_serif_bold : {
    . = ALIGN(4);
    KEEP(*(.sd_fonts_cp1252_sans_serif_bold))
  } > CORES

  .sd_fonts_cp1252_sans_serif : {
    . = ALIGN(4);
    KEEP(*(.sd_fonts_cp1252_sans_serif))
  } > CORES

  .sd_fonts_cp1252_serif_bold : {
    . = ALIGN(4);
    KEEP(*(.sd_fonts_cp1252_serif_bold))
  } > CORES

  .sd_fonts_cp1252_serif_cjk : {
    . = ALIGN(4);
    KEEP(*(.sd_fonts_cp1252_serif_cjk))
  } > CORES

  .sd_fonts_cp1252_serif : {
    . = ALIGN(4);
    KEEP(*(.sd_fonts_cp1252_serif))
  } > CORES

  .sd_fonts_cp1252_unbalanced : {
    . = ALIGN(4);
    KEEP(*(.sd_fonts_cp1252_unbalanced))
  } > CORES

  .sd_fonts_unicode_katakana : {
    . = ALIGN(4);
    KEEP(*(.sd_fonts_unicode_katakana))
  } > CORES

  .sd_fonts_unicode_kanji : {
    . = ALIGN(4);
    KEEP(*(.sd_fonts_unicode_kanji))
  } > CORES

  /* Every classic emulator's .overlay_<system>/.overlay_<system>_bss RAM
   * overlay (nes_fceu, tgb, sms/coleco, pce[+itc], msx, wsv, gw, md,
   * a2600, lynx, a7800, amstrad, zelda3/rodata_zelda3, smw, plus the whole
   * GBA split-layout block below) has been removed while migrating those
   * systems to standalone cores/<system>/ builds loaded from /cores/*.bin
   * at runtime (see "Cores externes avec ABI" plan). They all shared the
   * same __RAM_EMU_START__ VMA (only one core is ever resident at a
   * time), so removing them is safe; re-adding one is a copy of an old
   * git revision of this file, not a from-scratch design. PICO-8 (below)
   * and the graphics/font sections are untouched. */

  /* PICO-8 engine load address (RAM), at the LOW end of the LCD bonus area.
     No firmware-compiled stub occupies this VMA anymore (the GPL
     install-prompt stub, main_pico8_stub.c, was removed from the build —
     see Core/Src/porting/pico8/main_pico8_stub.c and rg_emulators.c). The
     real engine is loaded fresh from /cores/pico8.bin at runtime by
     emulator_start() every time a PICO-8 cart is launched; if that file is
     absent, nothing is dispatched (was previously a fallback to the stub).

     Layout — engine lives at the LOW end of the LCD bonus area:
       __RAM_UC_START__              = 0x24000000
       _PICO8_FB_OFFSET (LUT8 fb)    = 0x025800   (154 KB)
       __overlay_pico8_vma           = 0x24026800
       engine end (BSS_END, varies)
       TLSF main pool starts here, runs to __RAM_EMU_END__ = 0x24100000

     The LCD MUST be in LUT8 mode when pico8.bin is loaded into this
     range, otherwise the load overwrites the active RGB565 framebuffer.
     rg_emulators.c calls lcd_setup_framebuffers(LCD_MODE_LUT8) before
     load_core_bin_with_header("/cores/pico8.bin", ...).

     Why a fixed address, not a linked section: the firmware never
     compiles/links anything at this VMA anymore, it is purely a runtime
     load target address (like __RAM_EMU_START__ for the classic dynamic
     cores) — the engine's own entry trampoline zeroes its BSS at startup
     (equivalent of crt0), and main_pico8.c computes its TLSF pool from
     its own link-time BSS_END..__RAM_EMU_END__. So the engine can grow
     freely without anyone rebuilding this firmware. */
  _PICO8_FB_OFFSET = 2 * 320 * 240;          /* LUT8 framebuffer = 154 KB */
  __overlay_pico8_vma = __RAM_UC_START__ + _PICO8_FB_OFFSET;

  .overlay_graphics : {
    . = ALIGN(4);
    KEEP(*(.sdcard_logo))
  } > CORES

  /* The startup code goes first into FLASH */
  .isr_vector :
  {
    __flash_start__ = .;
    . = ALIGN(4);
    KEEP(*(.isr_vector)) /* Startup code */
    . = ALIGN(4);
  } >FLASH

  /* Firmware ABI table at a fixed offset from intflash start (0x400).
     Plugins (runtime-loaded overlays like the separately-distributed
     PICO-8 engine) resolve the absolute address at load time by reading
     VTOR and adding GW_FIRMWARE_ABI_OFFSET. Works regardless of whether
     the firmware runs from bank 1 (0x08000000) or bank 2 (0x08100000).
     See Core/Inc/retro-go/gw_firmware_abi.h for the contract. */
  .firmware_abi ORIGIN(FLASH) + 0x400 :
  {
    KEEP(*(.firmware_abi))
  } >FLASH

  /* The program code and other data goes into FLASH */
  .text :
  {
    . = ALIGN(4);
    *(.text)           /* .text sections (code) */
    *(.text*)          /* .text* sections (code) */
    *(.glue_7)         /* glue arm to thumb code */
    *(.glue_7t)        /* glue thumb to arm code */
    *(.eh_frame)

    KEEP (*(.init))
    KEEP (*(.fini))

    . = ALIGN(4);
    _etext = .;        /* define a global symbols at end of code */
  } >FLASH

  /* Constant data goes into FLASH */
  .rodata :
  {
    . = ALIGN(4);
    *(.rodata)         /* .rodata sections (constants, strings, etc.) */
    *(.rodata*)        /* .rodata* sections (constants, strings, etc.) */
    _intflash_logo_start = .;
    *(.intflash_logo)
    _intflash_logo_end = .;
    _intflash_global_start = .;
    *(.intflash_global)
    _intflash_global_end = .;
    . = ALIGN(4);
  } >FLASH

  .ARM.extab   : { *(.ARM.extab* .gnu.linkonce.armextab.*) } >FLASH
  .ARM : {
    __exidx_start = .;
    *(.ARM.exidx*)
    __exidx_end = .;
  } >FLASH

  .preinit_array     :
  {
    PROVIDE_HIDDEN (__preinit_array_start = .);
    KEEP (*(.preinit_array*))
    PROVIDE_HIDDEN (__preinit_array_end = .);
  } >FLASH
  .init_array :
  {
    PROVIDE_HIDDEN (__init_array_start = .);
    KEEP (*(SORT(.init_array.*)))
    KEEP (*(.init_array*))
    PROVIDE_HIDDEN (__init_array_end = .);
  } >FLASH
  .fini_array :
  {
    PROVIDE_HIDDEN (__fini_array_start = .);
    KEEP (*(SORT(.fini_array.*)))
    KEEP (*(.fini_array*))
    PROVIDE_HIDDEN (__fini_array_end = .);
  } >FLASH

  /* AHB SRAM: .persistent + .data/.bss + newlib heap + .audio.
   *   [.persistent 8K][.data][.bss][---- malloc heap ----][.audio 8K]
   * LMA for .data must follow FLASH sections above (not before .isr_vector).
   * Requires DATA_IN_D2_SRAM so SystemInit enables AHB SRAM before crt0
   * copies .data / zeroes .bss.
   * .persistent is padded to 8K so an MPU region can mark it non-cacheable
   * (OCD/monitor reads logbuf coherently; DTCM used to be inherently uncached).
   * Last 12 bytes hold the remote-input shadow word (was DTCM 0x2001FFF4). */
  ._persistent (NOLOAD) :
  {
    __ahbram_start__ = .;
    . = ALIGN(4);
    *(.persistent_boot_magic)
    *(.persistent_log_idx)
    *(.persistent_logbuf)
    . = ALIGN(4);
    ASSERT(. <= ORIGIN(AHBRAM) + __AHBRAM_PERSISTENT_RESERVE__ - __AHBRAM_REMOTE_INPUT_RESERVE__,
           "AHB .persistent overflows pad before remote-input reserve");
    . = ORIGIN(AHBRAM) + __AHBRAM_PERSISTENT_RESERVE__ - __AHBRAM_REMOTE_INPUT_RESERVE__;
    __remote_input__ = .;
    . = ORIGIN(AHBRAM) + __AHBRAM_PERSISTENT_RESERVE__;
  } > AHBRAM

  /* used by the startup to initialize data */
  _sidata = LOADADDR(.data);

  .data :
  {
    . = ALIGN(4);
    _sdata = .;
    *(.data)
    *(.data*)

    . = ALIGN(4);
    _edata = .;
  } > AHBRAM AT> FLASH

  ._flash_end :
  {
    . = ALIGN(4);
    __flash_end__ = .;
  } >FLASH

  .bss (NOLOAD) :
  {
    . = ALIGN(4);
    _sbss = .;
    __bss_start__ = _sbss;
    *(.bss)
    *(.bss*)
    *(COMMON)

    . = ALIGN(4);
    _ebss = .;
    __bss_end__ = _ebss;
  } > AHBRAM

  ._user_heap (NOLOAD) :
  {
    . = ALIGN(16);
    __ahbram_heap_start__ = .;
    _heap_start = .;

    _heap_end = ORIGIN(AHBRAM) + LENGTH(AHBRAM) - __AHBRAM_AUDIO_RESERVE__;
    ASSERT(_heap_start < _heap_end,
           "AHB overflow: .persistent/.data/.bss leave no room for malloc heap before .audio");
    . = _heap_end;
  } > AHBRAM

  ._ahbram_audio (NOLOAD) :
  {
    __ahbram_audio_start__ = .;
    *(.audio)
    . = ALIGN(4);
    __ahbram_end__ = .;
  } > AHBRAM

  ASSERT(__AHB_CORE_START__ == __ahbram_start__,
         "Error: ld/gnw_ahb_core.ld's __AHB_CORE_START__ no longer matches __ahbram_start__")
  ASSERT(__AHB_CORE_LENGTH__ <= (__ahbram_audio_start__ - __ahbram_start__),
         "Error: ld/gnw_ahb_core.ld's __AHB_CORE_LENGTH__ overlaps the .audio DMA reserve at the top of AHB SRAM")

  /* DTCM: bump pool from ORIGIN up to the stack redzone. */
  ._dtcm_free (NOLOAD) :
  {
    . = ALIGN(16);
    __dtcram_start__ = .;
    __dtc_padding_start__ = .;
    . = ORIGIN(DTCMRAM) + __DTCMRAM_LENGTH__
        - _Min_Stack_Size
        - _Stack_Redzone_Size;
    __dtc_padding_end__ = .;
  } >DTCMRAM

  ._user_stack (NOLOAD) :
  {
    _stack_redzone = .;
    . = . + _Stack_Redzone_Size;
    _stack_bottom = .;
    . = . + _Min_Stack_Size;
    _stack_top = .;
    __dtcram_end__ = .;
  } >DTCMRAM

  /* Remove information from the standard libraries */
  /DISCARD/ :
  {
    libc.a ( * )
    libm.a ( * )
    libgcc.a ( * )
  }

  .ARM.attributes 0 : { *(.ARM.attributes) }
}
